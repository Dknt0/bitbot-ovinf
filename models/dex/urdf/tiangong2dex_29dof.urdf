    <joint name="elbow_pitch_r_joint">
      <command_interface name="effort">
        <param name="min">-50</param>
        <param name="max">50</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.8</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="elbow_yaw_r_joint">
      <command_interface name="effort">
        <param name="min">-25</param>
        <param name="max">25</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wrist_pitch_r_joint">
      <command_interface name="effort">
        <param name="min">-25</param>
        <param name="max">25</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wrist_roll_r_joint">
      <command_interface name="effort">
        <param name="min">-25</param>
        <param name="max">25</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- gz_control plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find bitbot_gz)/config/dex_gz_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!--IMU plugin-->
  <gazebo reference="imu_waist_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>true</visualize>
      <topic>imu_data</topic>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    </sensor>
  </gazebo>

  <!-- RGBD camera plugin -->
  <gazebo reference="camera_body_front_link">
    <sensor name='depth_camera_sensor' type='depth_camera'>
      <pose>0 0 0 0.0 0.0 0</pose>
      <topic>/depth_camera/image_raw</topic>
      <camera_info_topic>/depth_camera/camera_info</camera_info_topic>
      <update_rate>60</update_rate>
      <camera name='depth_camera'>
        <pose>0 0 0 0 0 0</pose>
        <horizontal_fov>1.5632</horizontal_fov>
        <image>
          <width>64</width>
          <height>36</height>
          <format>R_FLOAT32</format>
          <anti_aliasing>4</anti_aliasing>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.01</stddev>
        </noise>
        <distortion>
          <k1>0</k1>
          <k2>0</k2>
          <k3>0</k3>
          <p1>0</p1>
          <p2>0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <lens>
          <type>pinhole</type>
        </lens>
      </camera>
    </sensor>
    <sensor name='color_camera_sensor' type='camera'>
      <!-- Same orientation as the depth camera: look along link +X -->
      <pose>0 0 0 0 0 0</pose>
      <topic>/color_camera/image_raw</topic>
      <camera_info_topic>/color_camera/camera_info</camera_info_topic>
      <update_rate>20</update_rate>
      <camera name='color_camera'>
        <pose>0 0 0 0 0 0</pose>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
          <anti_aliasing>4</anti_aliasing>
        </image>
        <clip>
          <near>0.10000000000000001</near>
          <far>100</far>
        </clip>
        <noise>
          <type>none</type>
          <mean>0</mean>
          <stddev>0</stddev>
        </noise>
        <distortion>
          <k1>0</k1>
          <k2>0</k2>
          <k3>0</k3>
          <p1>0</p1>
          <p2>0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <lens>
          <type>pinhole</type>
        </lens>
      </camera>
    </sensor>
  </gazebo>

  <!-- Customized plugin -->
  <gazebo>
    <plugin filename="RobotResetPlugin" name="gz::sim::systems::RobotResetPlugin">
      <robot_name>dex</robot_name>
      <reset_height>1.05</reset_height>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="PosePublisherPlugin" name="gz::sim::systems::PosePublisherPlugin">
      <model_name>dex</model_name>
      <link_name>pelvis</link_name>
    </plugin>
  </gazebo>

  <!-- Sensor system -->
  <gazebo>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>
</robot>
